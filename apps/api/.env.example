# Goblin Assistant API environment example
# Copy to api/.env (local only, never commit secrets)

# Database
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_SUPABASE_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Auth
SECRET_KEY=replace_with_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Core services
REDIS_URL=redis://localhost:6379/0
SENTRY_DSN=

# Datadog APM (DD_API_KEY is secret — set in Render dashboard, never commit)
DD_API_KEY=
DD_SERVICE=goblin-api
DD_ENV=development
DD_SITE=datadoghq.com
DD_TRACE_AGENTLESS=1
DD_TRACE_AGENT_URL=https://trace.agent.datadoghq.com
ENVIRONMENT=development
JIRA_PROVIDER_OPS_WEBHOOK_URL=
JIRA_PROVIDER_OPS_WEBHOOK_SECRET=
JIRA_PROVIDER_OPS_PROJECT_KEY=PROVOPS
JIRA_ENVIRONMENT=development

# AI providers (set only what you use)
OPENAI_API_KEY=sk-REPLACE_ME
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
GROQ_API_KEY=
SILICONEFLOW_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_AI_API_KEY=
DASHSCOPE_API_KEY=
AZURE_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_API_VERSION=2024-05-01-preview
AZURE_DEPLOYMENT_ID=
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

# Embeddings for semantic retrieval / RAG
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_MAX_INPUT_TOKENS=8000

# Colab Worker (disposable/ngrok-backed)
COLAB_WORKER_ENDPOINT=
COLAB_WORKER_API_KEY=
COLAB_WORKER_HEARTBEAT_ENABLED=true
COLAB_WORKER_HEARTBEAT_INTERVAL_SECONDS=60

# Self-development agent loop (persistent Sprite worker)
AGENT_SPRITE_WORKER_URL=
AGENT_WORKER_SECRET=
AGENT_WORKER_CALLBACK_SECRET=
AGENT_BACKEND_URL=http://localhost:8004
AGENT_DEFAULT_BASE_BRANCH=main
AGENT_TEST_COMMAND=make test-critical
AGENT_REPAIR_ATTEMPTS=2
GITHUB_REPOSITORY=
GITHUB_SERVER_URL=https://github.com

# PDF extraction
GOBLIN_PDF_OCR_ENABLED=false
GOBLIN_ATTACHMENT_CONTEXT_MAX_CHUNKS=5
GOBLIN_ATTACHMENT_CONTEXT_MAX_CHARS=5000

# Git tool (git_tool skill)
# Absolute path to the default git repository for git_* tools
GOBLIN_GIT_REPO=

# GitHub tool (github_tool skill)
# Personal access token — omit for read-only public repo access
GH_TOKEN=
# Legacy alias supported for older setups
GITHUB_TOKEN=

# Issue triage — target repo for auto-created bug reports
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# Rovo Dev (Goblin Coder) — Atlassian AI coding agent (internal, not user-facing)
# Auth: Bearer base64(email:token) + SSE session protocol
ATLASSIAN_EMAIL=your-atlassian-account@example.com
ATLASSIAN_API_TOKEN=
# Atlassian site Cloud ID — enables Jira context enrichment in Goblin Coder
# Find at: https://<your-site>.atlassian.net/_edge/tenant_info
ATLASSIAN_CLOUD_ID=
# Optional: override MCP endpoint (leave blank for default)
ROVO_DEV_ENDPOINT=

# Error alerts — Slack + Sentry webhook
SLACK_WEBHOOK_URL=
SENTRY_WEBHOOK_SECRET=

# Email alerts (SMTP)
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Self-hosted compute nodes (local-compute tier) ---
# Master switch. false makes routing behave exactly as it did before local
# compute existed -- the rollback path.
GOBLIN_LOCAL_NODES_ENABLED=false
# REQUIRED before any node can register. Unset = heartbeats refused (503).
GOBLIN_NODE_REGISTRATION_SECRET=
# Hosts a node may advertise as its endpoint, comma separated. SET THIS IN
# PRODUCTION: it is what stops a leaked secret becoming prompt exfiltration.
GOBLIN_NODE_ENDPOINT_ALLOWLIST=
# A heartbeat older than this marks a node offline. 90s tolerates two dropped
# beats against the agent's 30s default.
GOBLIN_NODE_HEARTBEAT_TTL=90
# Cap on discovering a node is absent (blackholed networks do not refuse).
GOBLIN_NODE_CONNECT_TIMEOUT=3
# Read timeout: generation on a 3060 is allowed to be slow.
GOBLIN_NODE_TIMEOUT=300
# Consecutive dispatch failures before shedding a node early.
GOBLIN_NODE_MAX_FAILURES=3
# Model requested when the caller names none.
GOBLIN_NODE_DEFAULT_MODEL=llama3.1:8b
# mTLS identity presented to node agents. Without a client cert signed by the
# node fleet CA, the node drops us at the TLS handshake by design.
GOBLIN_NODE_CLIENT_CERT=
GOBLIN_NODE_CLIENT_KEY=
GOBLIN_NODE_CA_CERT=
