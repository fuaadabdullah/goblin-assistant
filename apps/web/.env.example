# Goblin web local environment template
#
# Rules for this file:
# - Never put real secrets here.
# - Every NEXT_PUBLIC_* value is browser-exposed at build/runtime.
# - Replace placeholder values in your local .env.local as needed.

# Required for local development. Browser-exposed: yes.
# Local default/fallback: no file-level fallback; app code falls back to the hosted backend origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# Optional override. Browser-exposed: yes.
# Local default/fallback: if unset, backend origin resolution falls back to NEXT_PUBLIC_FASTAPI_URL,
# NEXT_PUBLIC_API_URL, NEXT_PUBLIC_API_BASE_URL, then the hosted backend origin.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8001

# Optional override. Browser-exposed: yes.
# Local default/fallback: if unset, frontend code falls back to NEXT_PUBLIC_BACKEND_URL or the hosted backend origin.
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8001

# Optional compatibility alias. Browser-exposed: yes.
# Local default/fallback: only used by backend-origin resolution when the variables above are unset.
NEXT_PUBLIC_API_URL=http://localhost:8001

# Optional debug flag. Browser-exposed: yes.
# Local default/fallback: false.
NEXT_PUBLIC_ENABLE_DEBUG=false

# Optional feature flags. Browser-exposed: yes.
# Local default/fallbacks: false unless otherwise noted inline.
NEXT_PUBLIC_FEATURE_RAG_ENABLED=false
NEXT_PUBLIC_FEATURE_MULTI_PROVIDER=false
NEXT_PUBLIC_FEATURE_PASSKEY_AUTH=false
NEXT_PUBLIC_FEATURE_GOOGLE_AUTH=true
NEXT_PUBLIC_FEATURE_SANDBOX=false
NEXT_PUBLIC_FEATURE_SEARCH=true
NEXT_PUBLIC_FEATURE_ADMIN=false
NEXT_PUBLIC_DEBUG_MODE=false

# Optional Cloudflare Turnstile site keys. Browser-exposed: yes.
# Local default/fallback: empty disables the corresponding widget.
# Use placeholder site keys only; never put secret Turnstile keys in the web app.
NEXT_PUBLIC_TURNSTILE_SITE_KEY_CHAT=0xchat-placeholder
NEXT_PUBLIC_TURNSTILE_SITE_KEY_LOGIN=0xlogin-placeholder
NEXT_PUBLIC_TURNSTILE_SITE_KEY_SEARCH=0xsearch-placeholder

# Optional Supabase browser client configuration. Browser-exposed: yes.
# Local default/fallback: app uses placeholder values and disables realtime-dependent flows when unset.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key

# Optional monitoring configuration. Browser-exposed: yes.
# Local default/fallback: empty disables the integration unless noted otherwise.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_DD_APPLICATION_ID=
NEXT_PUBLIC_DD_CLIENT_TOKEN=
NEXT_PUBLIC_DD_SITE=datadoghq.com
NEXT_PUBLIC_DD_ENV=development
NEXT_PUBLIC_DD_VERSION=local

# Optional public site metadata. Browser-exposed: yes.
# Local default/fallback: sitemap/SEO fall back to the production site URL when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional admin allowlist overrides. Browser-exposed: yes.
# Local default/fallback: empty means email/domain allowlists are disabled.
# Comma-separated values, for example: admin@example.com,owner@example.com
NEXT_PUBLIC_ADMIN_EMAILS=
NEXT_PUBLIC_ADMIN_DOMAINS=